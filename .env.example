# Server
PORT=4000
ML_URL=http://127.0.0.1:8001
# Horario del cron de sincronización con ESPN (formato node-cron). Por defecto: diario 06:00
# SYNC_CRON=0 6 * * *
# Ruta de la DB (por defecto: server/data/futbol.db)
# DB_PATH=server/data/futbol.db
# Token requerido por POST /api/refresh (genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
REFRESH_TOKEN=

# CORS: origenes permitidos separados por coma (vacío = todos, para desarrollo local)
# CORS_ORIGINS=http://localhost:5173

# Zona horaria para fechas locales (por defecto: America/Guayaquil)
# TZ=America/Guayaquil

# Confiar en cabeceras X-Forwarded-For (solo detrás de un proxy). Off por defecto.
# TRUST_PROXY=true

## Cloudflare (solo deploy, rama feat/deploy-cloudflare)
# Origen del front en Pages (fail-closed: vacío = se niega todo origen cruzado).
# CORS_ORIGINS=https://futboltipster.pages.dev
# URL pública del Worker + /api. Es variable de BUILD de Pages, no de runtime.
# VITE_API_URL=https://futboltipster-worker.<tu-subdominio>.workers.dev/api
# REFRESH_TOKEN (arriba) se configura como secret, nunca en wrangler.toml:
#   wrangler secret put REFRESH_TOKEN
# Fixtures en cloud: football-data.org v4, plan gratuito (10 req/min sin tope
# mensual; registro solo email): https://www.football-data.org/client/register
# Cubre las 5 ligas europeas (~6 req/día). EC1 no está cubierto: llega por relay.
#   wrangler secret put FOOTBALL_DATA_KEY
# Token del relay EC1 (generar uno distinto de REFRESH_TOKEN):
#   wrangler secret put CLOUD_TOKEN
# Relay EC1 del server local al Worker (vacío = desactivado):
# CLOUD_SYNC_URL=https://futboltipster-worker.<tu-subdominio>.workers.dev
# CLOUD_SYNC_TOKEN=<mismo valor que CLOUD_TOKEN>
# Cron fijo en worker/wrangler.toml: "0 11 * * *" UTC = 06:00 America/Guayaquil.
# SYNC_CRON/ML_URL/DB_PATH son solo-locales y se ignoran en el Worker.