{
  "name": "futboltipster-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run tests/footballData.test.ts",
    "lint": "eslint src tests --max-warnings 0",
    "format": "prettier --write src tests eslint.config.js",
    "bundle": "esbuild src/index.ts --bundle --minify --format=esm --platform=neutral --outfile=dist/bundle.js",
    "bundle:size": "npm run bundle --silent && node scripts/bundle-size.mjs"
  },
  "dependencies": {
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
